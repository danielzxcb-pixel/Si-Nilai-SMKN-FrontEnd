CI_ENVIRONMENT = production
app.baseURL = 'http://127.0.0.1:8000'

JWT_SECRET_KEY = 'generate-your-64-char-random-key-here'
JWT_ALGORITHM = 'HS256'
JWT_EXPIRY_HOURS = 4

RATE_LIMIT_LOGIN_MAX_ATTEMPTS = 5
RATE_LIMIT_LOGIN_DECAY_MINUTES = 15

DB_DRIVER = 'SQLite3'
DB_DATABASE = 'writable/database.sqlite'

CORS_ALLOWED_ORIGIN = 'http://localhost:5173'
