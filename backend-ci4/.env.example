# ============================================================
# SiNilai SMK — Backend Environment Variables
# ============================================================
# FILE INI TIDAK BOLEH DI-COMMIT KE GITHUB.
# Sudah dikecualikan di .gitignore.
#
# Untuk Railway production:
#   - Hapus file ini dari server
#   - Gunakan Railway Dashboard > Variables untuk isi semua nilai ini
# ============================================================

# === Database (Railway MySQL) ===
# Untuk production, gunakan jaringan internal Railway:
#   MYSQL_HOST=mysql.railway.internal (lebih cepat, gratis, aman)
# Untuk akses luar Railway (misal: local dev ke Railway DB):
#   MYSQL_HOST=sakura.proxy.rlwy.net (TCP proxy, butuh SSL)
MYSQL_HOST=mysql.railway.internal
MYSQL_PORT=3306
MYSQL_DATABASE=railway
MYSQL_USER=root
MYSQL_PASSWORD=GANTI_DENGAN_PASSWORD_RAILWAY_ANDA

# === JWT Secret (WAJIB diganti dengan string acak 64+ karakter) ===
# Generate di: https://generate-secret.vercel.app/64
JWT_SECRET=GANTI_DENGAN_SECRET_KEY_ACAK_64_KARAKTER_MINIMUM

# === App Environment ===
APP_ENV=production
APP_DEBUG=false
